# Copy to .env and fill in what the builds you actually run need.
# .env is gitignored. Nothing here is required to run the test suites.

# ---------------------------------------------------------------- model access
# Gemini. Needed by: image-ad-creator (image generation), visitor-identification
# (email drafting), cold-email-campaign (copy generation).
# A 429 from this key is not always a rate limit: a spending cap returns the same
# status. Raise the cap at https://ai.studio/spend
GEMINI_API_KEY=

# ------------------------------------------------------------- cold email send
# Instantly. Needed by: cold-email-campaign, to build and update the campaign.
# Must be a V2 key, from Settings > Integrations > API Keys. A V1 key returns 401
# on the v2 base URL with no useful message, which is the most likely reason a
# working setup suddenly stops authenticating.
INSTANTLY_API_KEY=

# ------------------------------------------------------- tech stack enrichment
# All optional. The default provider is `mock` for the visitor pipeline and
# `passthrough` for cold email, and both run with no key at all. Add one of these
# only when you want live technographics. See execution/shared/enrichment_providers.py
#
# Apollo is the best single choice: one call returns the person AND their
# organization's current technologies, so it can serve sourcing and enrichment both.
APOLLO_API_KEY=
BUILTWITH_API_KEY=
CLEARBIT_API_KEY=

# Lead sourcing. Documented in execution/cold_email/scrape_leads.py but NOT wired:
# the stub raises rather than inventing rows. Implement fetch_apify() before setting this.
APIFY_TOKEN=

# ----------------------------------------------------------- outreach identity
# Who the drafted emails come from. Lands in the .eml From: header and the sign-off.
# Unset falls back to an obvious placeholder so nothing ships under the wrong name.
SENDER_NAME=
SENDER_EMAIL=

# --------------------------------------------------------------- google drive
# Delivery of ad batches and the visitor dashboard. Only one of these is needed.
# Checked in this order: service account, then inline token, then ./token.json.
#
# Local: run `python execution/shared/authorize_google_drive.py` once to write
# token.json, and leave both of these empty.
# Unattended or cloud: paste the CONTENTS of token.json into GOOGLE_OAUTH_TOKEN_JSON,
# so no credential file has to exist on disk.
#
# The OAuth app must be published to Production, not left in Testing. A Testing app
# with External user type has its refresh token revoked by Google after 7 days, which
# kills an unattended daily job silently, once a week. Publishing needs no verification
# review because the scope used here (drive.file) is non-sensitive.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_TOKEN_JSON=

# ------------------------------------------------------------------- chromium
# Only needed when Playwright's own browser download is unavailable or the wrong
# revision, which is the usual case inside a sandbox that ships its own Chromium.
# Pass a path rather than pinning a playwright version against it.
AD_CREATOR_CHROMIUM=
PLAYWRIGHT_BROWSERS_PATH=
